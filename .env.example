# 複製此檔為 .env 並填入實際值
# cp .env.example .env

# ── 安全性 ────────────────────────────────────────────────────
# JWT 簽名金鑰，生產環境請改為 64 字元以上的隨機字串
# 產生範例：openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

# JWT token 有效期（分鐘），預設 7 天（10080）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 後台帳號 ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── CORS ─────────────────────────────────────────────────────
# 允許跨來源呼叫 API 的網域，逗號分隔
# 生產環境只填實際網域，不要留 localhost
ALLOWED_ORIGINS=https://www.youmood.shop

# ── 資料儲存 ──────────────────────────────────────────────────
# Docker volume 內的資料根目錄（通常不需要改）
DATA_DIR=/data

# ── 備份 ─────────────────────────────────────────────────────
# 備份保留天數（超過此天數的備份檔自動刪除）
BACKUP_RETAIN_DAYS=7
